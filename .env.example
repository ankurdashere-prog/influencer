# Is file ko copy karke ".env" naam do aur keys bharo. ".env" ko KABHI GitHub par upload mat karo.

# ---- Script / caption (Gemini free API: aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Image generation ----
# openai        = reference image se same face (paid, per image)
# pollinations  = free, key nahi chahiye (same face ki guarantee kam)
# placeholder   = sirf test ke liye
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low

# ---- Voice (edge = free, internet chahiye) ----
TTS_PROVIDER=edge            # edge | gtts | silent (edge fail ho to gtts khud use hota hai)
TTS_VOICE=en-IN-NeerjaNeural

# ---- Instagram (Meta Graph API) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v23.0

# ---- Public video hosting (Supabase Storage free tier, bucket PUBLIC rakho) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=influencer-media

# ---- Web dashboard ----
# Dashboard ka login password (username kuch bhi). Cloud par ZAROORI.
APP_PASSWORD=
# Roz ki auto-post ko trigger karne wala secret token (cron-job.org mein use hota hai)
CRON_TOKEN=
